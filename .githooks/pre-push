#!/usr/bin/env sh
# .githooks/pre-push
#
# Dev Sentinel — Git pre-push hook (for the bob-pr-sentinel source repo itself)
#
# For external repositories: install with `dev-sentinel install`
# which writes .git/hooks/pre-push using the installed CLI entry point.
#
# To bypass: git push --no-verify
# To uninstall: dev-sentinel uninstall

exec dev-sentinel-hook
